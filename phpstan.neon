includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - packages/admin/src
        - packages/cms/src
        - packages/starter-kit/src
    ignoreErrors:
        # PHPStan types filter_var() with FILTER_FLAG_GLOBAL_RANGE as never returning false, but it does for
        # every non-global address (tests/Admin/PublicAddressTest.php), which is what this check relies on.
        # Newer PHPStan releases type it correctly, so the ignore may match nothing (reportUnmatched: false).
        -
            identifier: identical.alwaysFalse
            path: packages/admin/src/Support/PublicAddress.php
            reportUnmatched: false
        # Laravel 13's Paginator contract documents render() as returning a string up to 13.37 and an Htmlable in
        # later releases, so LazyEntries::render() can't match both; it keeps returning the string it always has.
        -
            identifier: method.childReturnType
            path: packages/cms/src/Site/LazyEntries.php
            reportUnmatched: false
