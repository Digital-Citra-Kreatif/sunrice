{
    "name": "sunrice/admin",
    "description": "An admin panel framework for Laravel: auth, users and roles, resources, custom React pages, settings, media, activity and security, and AI access.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "admin",
        "admin-panel",
        "inertia",
        "react"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image": "^3.0",
        "laravel/mcp": "^1.0",
        "spatie/laravel-permission": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Sunrice\\Admin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunrice\\Admin\\AdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
