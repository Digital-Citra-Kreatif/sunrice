{
    "name": "@imajiner/admin-sdk",
    "version": "0.1.0",
    "description": "Build admin pages for Sunrice panel plugins: shares the panel's React, Inertia and UI components.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./shared": {
            "types": "./dist/shared.d.ts",
            "default": "./dist/shared.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./ui": {
            "types": "./dist/ui.d.ts",
            "default": "./dist/ui.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "vite": "^7.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "@types/react": "^19.0.0",
        "typescript": "^5.6.3",
        "vite": "^7.0.0"
    }
}
