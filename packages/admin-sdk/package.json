{
    "name": "@imajiner/admin-sdk",
    "version": "0.7.0",
    "description": "Build admin pages for Sunrice panel plugins: shares the panel's React, Inertia and UI components.",
    "license": "MIT",
    "homepage": "https://github.com/Digital-Citra-Kreatif/sunrice/blob/main/packages/admin/docs/frontend.md",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Digital-Citra-Kreatif/sunrice.git",
        "directory": "packages/admin-sdk"
    },
    "bugs": {
        "url": "https://github.com/Digital-Citra-Kreatif/sunrice/issues"
    },
    "keywords": [
        "sunrice",
        "laravel",
        "admin",
        "inertia",
        "react",
        "vite-plugin"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./shared": {
            "types": "./dist/shared.d.ts",
            "default": "./dist/shared.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./ui": {
            "types": "./dist/ui.d.ts",
            "default": "./dist/ui.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "vite": "^7.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "@types/react": "^19.0.0",
        "typescript": "^5.6.3",
        "vite": "^7.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
